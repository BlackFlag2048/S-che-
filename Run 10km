<script>
  // Count total sessions (2 per week × 27 weeks = 54, minus a few rest entries)
  const sessions = document.querySelectorAll('.session-row');
  const STORAGE_KEY = 'training10km_done';
  const total = sessions.length;

  function updateBar() {
    const done = document.querySelectorAll('.session-row.done').length;
    const pct = Math.round((done / total) * 100);
    document.getElementById('bar').style.width = pct + '%';
    document.getElementById('countLabel').textContent = `${done} / ${total} séances`;
  }

  function saveState() {
    const state = [];
    sessions.forEach((row, i) => {
      if (row.classList.contains('done')) state.push(i);
    });
    localStorage.setItem(STORAGE_KEY, JSON.stringify(state));
  }

  function loadState() {
    try {
      const saved = JSON.parse(localStorage.getItem(STORAGE_KEY) || '[]');
      saved.forEach(i => {
        if (sessions[i]) sessions[i].classList.add('done');
      });
    } catch(e) {}
  }

  // Load saved state on startup
  loadState();
  updateBar();

  // Click to toggle done
  sessions.forEach((row, i) => {
    row.style.cursor = 'pointer';
    row.addEventListener('click', function() {
      this.classList.toggle('done');
      updateBar();
      saveState();
    });
  });
</script>

<style>
  .session-row.done {
