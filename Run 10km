<!DOCTYPE html>

<html lang="fr">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Programme 10km — 8 novembre</title>
<style>
  @import url('https://fonts.googleapis.com/css2?family=Bebas+Neue&family=DM+Sans:wght@300;400;500;600&family=DM+Mono:wght@400;500&display=swap');

:root {
–bg: #0d0f14;
–surface: #13161d;
–card: #1a1e27;
–border: #252a36;
–green: #4ade80;
–yellow: #fbbf24;
–red: #f87171;
–blue: #60a5fa;
–muted: #4a5168;
–text: #e2e8f0;
–text-dim: #8892a4;
}

- { box-sizing: border-box; margin: 0; padding: 0; }

body {
background: var(–bg);
color: var(–text);
font-family: ‘DM Sans’, sans-serif;
min-height: 100vh;
padding: 24px 16px 60px;
}

header {
text-align: center;
margin-bottom: 40px;
padding-top: 12px;
}

header .label {
font-family: ‘DM Mono’, monospace;
font-size: 11px;
letter-spacing: 3px;
text-transform: uppercase;
color: var(–muted);
margin-bottom: 8px;
}

header h1 {
font-family: ‘Bebas Neue’, sans-serif;
font-size: clamp(48px, 12vw, 88px);
letter-spacing: 2px;
line-height: 1;
color: var(–text);
}

header h1 span {
color: var(–green);
}

header .subtitle {
margin-top: 10px;
font-size: 14px;
color: var(–text-dim);
font-weight: 300;
}

.legend {
display: flex;
gap: 20px;
justify-content: center;
flex-wrap: wrap;
margin-bottom: 36px;
}

.legend-item {
display: flex;
align-items: center;
gap: 8px;
font-size: 12px;
color: var(–text-dim);
font-family: ‘DM Mono’, monospace;
}

.dot {
width: 10px;
height: 10px;
border-radius: 50%;
flex-shrink: 0;
}

.phase-block {
margin-bottom: 40px;
}

.phase-header {
display: flex;
align-items: center;
gap: 16px;
margin-bottom: 16px;
padding: 0 4px;
}

.phase-tag {
font-family: ‘Bebas Neue’, sans-serif;
font-size: 22px;
letter-spacing: 1px;
}

.phase-tag.p1 { color: var(–green); }
.phase-tag.p2 { color: var(–yellow); }
.phase-tag.p3 { color: var(–red); }
.phase-tag.race { color: var(–blue); }

.phase-desc {
font-size: 12px;
color: var(–text-dim);
font-family: ‘DM Mono’, monospace;
}

.week-group {
background: var(–card);
border: 1px solid var(–border);
border-radius: 12px;
margin-bottom: 8px;
overflow: hidden;
transition: border-color 0.2s;
}

.week-group:hover {
border-color: #353d52;
}

.week-group.light {
border-color: #fbbf2440;
background: #1a1e27;
}

.week-label {
padding: 10px 16px;
background: #161a23;
font-family: ‘DM Mono’, monospace;
font-size: 11px;
color: var(–muted);
letter-spacing: 1px;
text-transform: uppercase;
border-bottom: 1px solid var(–border);
display: flex;
align-items: center;
gap: 8px;
}

.week-label .light-badge {
background: #fbbf2415;
color: var(–yellow);
border: 1px solid #fbbf2440;
border-radius: 4px;
padding: 1px 6px;
font-size: 10px;
}

.session-row {
display: grid;
grid-template-columns: 90px 60px 1fr;
align-items: center;
padding: 12px 16px;
gap: 12px;
border-bottom: 1px solid #1e2330;
}

.session-row:last-child {
border-bottom: none;
}

.session-date {
font-family: ‘DM Mono’, monospace;
font-size: 12px;
color: var(–text-dim);
}

.session-day {
font-size: 11px;
font-family: ‘DM Mono’, monospace;
color: var(–muted);
text-transform: uppercase;
letter-spacing: 1px;
}

.session-content {
display: flex;
flex-direction: column;
gap: 3px;
}

.session-title {
font-size: 13px;
font-weight: 500;
color: var(–text);
line-height: 1.3;
}

.session-detail {
font-size: 11px;
color: var(–text-dim);
font-family: ‘DM Mono’, monospace;
}

.tag {
display: inline-block;
padding: 2px 7px;
border-radius: 4px;
font-size: 10px;
font-family: ‘DM Mono’, monospace;
font-weight: 500;
margin-right: 6px;
vertical-align: middle;
}

.tag.ef { background: #4ade8018; color: var(–green); border: 1px solid #4ade8030; }
.tag.obj { background: #fbbf2418; color: var(–yellow); border: 1px solid #fbbf2430; }
.tag.mix { background: #60a5fa18; color: var(–blue); border: 1px solid #60a5fa30; }
.tag.rest { background: #f8717118; color: var(–red); border: 1px solid #f8717130; }

.race-card {
background: linear-gradient(135deg, #1a2535, #1a1e27);
border: 1px solid #60a5fa40;
border-radius: 16px;
padding: 28px 24px;
text-align: center;
position: relative;
overflow: hidden;
}

.race-card::before {
content: ‘’;
position: absolute;
top: -40px; right: -40px;
width: 160px; height: 160px;
background: radial-gradient(circle, #60a5fa10, transparent 70%);
border-radius: 50%;
}

.race-card .flag {
font-size: 32px;
margin-bottom: 8px;
}

.race-card .race-date {
font-family: ‘Bebas Neue’, sans-serif;
font-size: 36px;
color: var(–blue);
letter-spacing: 2px;
}

.race-card .race-title {
font-family: ‘Bebas Neue’, sans-serif;
font-size: 28px;
color: var(–text);
letter-spacing: 1px;
margin: 4px 0;
}

.race-card .race-goal {
font-family: ‘DM Mono’, monospace;
font-size: 13px;
color: var(–text-dim);
margin-top: 8px;
}

.race-card .strat {
background: #ffffff08;
border-radius: 10px;
padding: 14px 16px;
margin-top: 16px;
text-align: left;
}

.race-card .strat p {
font-size: 12px;
color: var(–text-dim);
line-height: 1.7;
font-family: ‘DM Mono’, monospace;
}

.race-card .strat p strong {
color: var(–text);
}

.progress-bar-wrap {
background: var(–card);
border: 1px solid var(–border);
border-radius: 12px;
padding: 16px 20px;
margin-bottom: 32px;
display: flex;
align-items: center;
gap: 16px;
flex-wrap: wrap;
}

.progress-bar-wrap .label {
font-family: ‘DM Mono’, monospace;
font-size: 11px;
color: var(–muted);
white-space: nowrap;
}

.bar-outer {
flex: 1;
height: 6px;
background: var(–border);
border-radius: 99px;
min-width: 100px;
overflow: hidden;
}

.bar-inner {
height: 100%;
border-radius: 99px;
background: linear-gradient(90deg, var(–green), var(–yellow) 50%, var(–red));
width: 0%;
transition: width 1s ease;
}

.count-label {
font-family: ‘Bebas Neue’, sans-serif;
font-size: 18px;
color: var(–text);
white-space: nowrap;
}

@media (max-width: 480px) {
.session-row {
grid-template-columns: 80px 52px 1fr;
gap: 8px;
padding: 10px 12px;
}
.session-date { font-size: 11px; }
.session-title { font-size: 12px; }
}
</style>

</head>
